# 依赖与构建产物 —— 这些不进仓库
node_modules/
dist/
dist-ssg/
.vite/
*.local

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# 环境变量与密钥 —— 这是最重要的一组，别删
#
# 任何 .env 文件都可能装着密钥，一律不进仓库。
# 唯一例外是 .env.example：它是空模板，故意要提交，好让你知道该往哪填。
.env
.env.*
!.env.example

# 私钥 / 证书 —— 这种东西不该出现在一个博客仓库里
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*

# 各种工具的凭据文件
.npmrc
.netrc
credentials.json
service-account*.json

# 云服务 CLI 的本地配置
.aws/
.azure/
.gcloud/

# Python（做图片和字体处理时产生的缓存）
__pycache__/
*.pyc

# Pagefind 中间产物
pagefind/

# 临时目录
tmp/
.tmp/

# 本地预览用的目录联接（把 dist 挂到 /blog/ 下验证子路径）
.preview/

# 插画原始大图（从素材站下载的原始文件，上百 MB）
# 处理后的成品在 public/art 和 public/gallery，原图只留本地
raw/

# 拆出来的小说全文 —— 会进仓库，但你要知道代价
#
# npm run novel 会把 EPUB 拆成 public/novels/<slug>/（章节 HTML + 封面 + 插图），
# 这些是网站的一部分，得跟着仓库走，线上才读得到。
#
# ⚠️ 但《埃罗芒阿老师》是电击文库的商业出版物，中文版基本是民间汉化。
#    把全文推到公开仓库 = 公开分发受版权保护的作品。
#    GitHub 收到 DMCA 投诉不是下掉那一页，是整个站点一起停掉。
#    哪天不想担这个风险：删掉 public/novels/<slug>/ 重新提交即可，
#    阅读器会自动显示"这本书只在本地版本里"，不会报错。
#
# 详见 docs/EDITING.md 第 14 节。
#
# 原始 EPUB 不进仓库：它是源文件，几十 MB，成品已经拆好了
*.epub

# AI 助手的中间文件（计划、缓存），跟网站本身无关，不该出现在公开仓库
.zcode/

# 本地验收截图（几十张长图，只给自己看，不进公开仓库）
验收截图/
