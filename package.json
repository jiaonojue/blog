{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "个人博客：番剧感想、技术备忘与随笔",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run content:index && vite --host 127.0.0.1 --port 5178",
    "build": "npm run content:index && vite-ssg build && npm run build:post",
    "content:index": "node scripts/build-content-index.mjs",
    "build:post": "node scripts/postbuild.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4178",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check \"**/*.{ts,vue,css,mjs,json,md,yml}\"",
    "format": "prettier --write \"**/*.{ts,vue,css,mjs,json,md,yml}\"",
    "check": "npm run check:secrets && npm run typecheck && npm run lint && npm run format:check && npm run build && npm run check:assets",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "images": "node scripts/run-py.mjs scripts/optimize-images.py",
    "fonts": "node scripts/run-py.mjs scripts/subset-font.py",
    "new:post": "node scripts/new-post.mjs"
  },
  "dependencies": {
    "@fontsource/lxgw-wenkai": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@fontsource/zcool-kuaile": "5.3.0",
    "@lucide/vue": "^1.79.0",
    "docx-preview": "^0.4.1",
    "vue": "3.5.46",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@shikijs/markdown-it": "4.6.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.18.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "beasties": "^0.3.5",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "gray-matter": "4.0.3",
    "markdown-it": "^15.0.3",
    "markdown-it-async": "^2.2.0",
    "pagefind": "1.6.0",
    "prettier": "^3.6.2",
    "shiki": "4.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "8.3.8",
    "vite-ssg": "28.3.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "3.3.14"
  }
}
